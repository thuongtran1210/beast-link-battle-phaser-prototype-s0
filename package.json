{
  "name": "beast-link-battle-validation-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test",
    "build": "tsc -b && vite build",
    "check": "esbuild src/game/runChecks.ts --bundle --platform=node --format=cjs --outfile=dist/checks.cjs && node dist/checks.cjs",
    "preview": "vite preview",
    "check:studio-server": "node scripts/unit-editor-server-checks.js",
    "server": "node scripts/start-game-server.js",
    "check:online": "esbuild src/server/OnlineClientChecks.ts --bundle --platform=node --format=cjs --outfile=dist/online-checks.cjs && node dist/online-checks.cjs",
    "check:p2p": "esbuild src/network/p2p/PeerSessionChecks.ts --bundle --platform=node --format=cjs --outfile=dist/p2p-checks.cjs && node dist/p2p-checks.cjs"
  },
  "dependencies": {
    "@types/ws": "^8.18.2",
    "peerjs": "^1.5.5",
    "phaser": "^3.90.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
